{
  "name": "connect4",
  "description": "A Bun-based Connect4 Game API.",
  "version": "0.1.0",
  "author": "Dimitri Sifoua <dimitri.sifoua@.com>",
  "license": "Apache-2.0",
  "module": "src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "cache:up": "docker compose up -d cache",
    "cache:down": "docker compose down cache",
    "database:up": "docker compose up -d database",
    "database:down": "docker compose down database",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "orm:generate": "bunx drizzle-kit generate",
    "orm:migrate": "bunx drizzle-kit migrate",
    "dev": "bun --watch --env-file=.env run src/server.ts",
    "clean": "rm -rf coverage/ drizzle/"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.21.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "jose": "^6.1.3",
    "mysql2": "^3.16.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.2.1"
  }
}
